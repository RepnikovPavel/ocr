# GLM-OCR serving image for the 4090 (driver 565 / CUDA 12.7 in-container).
#
# Why this base: every public vllm/vllm-openai tag is built for a CUDA the host
# either refuses (toolkit blocks cuda>=12.9 in legacy mode) or cannot run
# (torch "driver too old"). dots-mocr:bench-cu126 carries torch 2.11+cu126 that
# is *already proven* to initialize CUDA on this exact box, plus transformers
# 5.5.4 (>=5.1.0, which is where GlmOcrConfig landed). We only add vLLM on top.
#
# vLLM nightly is required: stable 0.16 pins transformers<5, so GLM-OCR's
# config is unknown to it (vllm-project/vllm#35393). --pre pulls a build that
# carries the glm_ocr model + MTP speculative decode.
#
# Build:
#   docker build -t glm-ocr:vllm-cu126 -f docker/Dockerfile.glm .
ARG BASE_IMAGE=dots-mocr:bench-cu126
FROM ${BASE_IMAGE}

# Bring vLLM in WITHOUT disturbing the base's working torch 2.11+cu126. vLLM's
# nightly publishes cu126 wheels, so a normal install resolves to a binary and
# does not rebuild torch; we then assert the torch ABI is unchanged. (Earlier
# --no-build-isolation attempts failed because vLLM's build backend then went
# missing — a plain install lets pip fetch its own isolated build deps.)
RUN pip install --pre vllm \
    && python3 -c "import vllm, torch, transformers; \
        print('vllm', vllm.__version__); \
        print('torch', torch.__version__, 'cuda', torch.version.cuda); \
        print('transformers', transformers.__version__); \
        assert torch.version.cuda == '12.6', 'torch CUDA changed — base stack overwritten'"

EXPOSE 8000
